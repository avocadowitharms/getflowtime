{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve Flowtime",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\serve.ps1",
        "-Port",
        "5500"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "flowtime-preview",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Flowtime preview",
          "endsPattern": "Flowtime preview ready"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Open Flowtime Preview",
      "type": "shell",
      "command": "Start-Process",
      "args": [
        "http://localhost:5500/index.html"
      ],
      "dependsOn": "Serve Flowtime",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
